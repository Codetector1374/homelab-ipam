# Local development: no login; never use this mode in production.
NODE_ENV=development
AUTH_MODE=development
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/ipam.db

# Production: set NODE_ENV=production and AUTH_MODE=oidc, then supply all four.
# PUBLIC_URL must be the external HTTPS origin, without a path.
# Kanidm issuer (NOT the discovery document URL):
# https://idm.example.com/oauth2/openid/ipam
# Discovery is issuer + /.well-known/openid-configuration.
# Register exactly https://ipam.example.com/auth/callback in Kanidm.
# Keep PKCE enabled; Kanidm uses S256, ES256 ID tokens and HTTP Basic client auth.
# PUBLIC_URL=https://ipam.example.com
# OIDC_ISSUER=https://idm.example.com/oauth2/openid/ipam
# OIDC_CLIENT_ID=ipam
# OIDC_CLIENT_SECRET=REPLACE_WITH_KANIDM_BASIC_SECRET
# The server reads process environment; this file is a template, not auto-loaded.
# Logout is local: POST /auth/logout clears the IPAM session, not Kanidm SSO.
